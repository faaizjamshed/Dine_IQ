  "cleaning_audit": [
    {
      "table": "customers",
      "rule": "deduplicate_primary_key",
      "issue": "repeated primary key",
      "affected_records": 75,
      "action": "keep one record per key",
      "justification": "processed layer requires unique identifiers; raw records remain unchanged",
      "before_count": 75075,
      "after_count": 75000
    },
    {
      "table": "customers",
      "rule": "fill_missing_city",
      "issue": "missing city",
      "affected_records": 225,
      "action": "set city to Unknown",
      "justification": "retain customer while marking unavailable location explicitly",
      "before_count": 75075,
      "after_count": 75000
    },
    {
      "table": "customers",
      "rule": "table_row_count",
      "issue": "cleaning row accounting",
      "affected_records": 75,
      "action": "row count verified",
      "justification": "all nonduplicate rows preserved",
      "before_count": 75075,
      "after_count": 75000
    },
    {
      "table": "orders",
      "rule": "fill_missing_channel",
      "issue": "missing ordering channel",
      "affected_records": 1300,
      "action": "set channel to Unknown",
      "justification": "preserve transaction without inventing a channel",
      "before_count": 650000,
      "after_count": 650000
    },
    {
      "table": "orders",
      "rule": "null_negative_discount",
      "issue": "negative discount",
      "affected_records": 325,
      "action": "set discount to null",
      "justification": "negative discount is invalid and zero would claim no discount",
      "before_count": 650000,
      "after_count": 650000
    },
    {
      "table": "orders",
      "rule": "table_row_count",
      "issue": "cleaning row accounting",
      "affected_records": 0,
      "action": "row count verified",
      "justification": "all nonduplicate rows preserved",
      "before_count": 650000,
      "after_count": 650000
    },
    {
      "table": "order_items",
      "rule": "deduplicate_primary_key",
      "issue": "repeated primary key",
      "affected_records": 600,
      "action": "keep one record per key",
      "justification": "processed layer requires unique identifiers; raw records remain unchanged",
      "before_count": 3000600,
      "after_count": 3000000
    },
    {
      "table": "order_items",
      "rule": "null_invalid_quantity",
      "issue": "nonpositive quantity",
      "affected_records": 1500,
      "action": "set quantity to null",
      "justification": "do not fabricate a valid quantity or price",
      "before_count": 3000600,
      "after_count": 3000000
    },
    {
      "table": "order_items",
      "rule": "null_invalid_unit_price",
      "issue": "nonpositive unit_price",
      "affected_records": 1200,
      "action": "set unit_price to null",
      "justification": "do not fabricate a valid quantity or price",
      "before_count": 3000600,
      "after_count": 3000000
    },
    {
      "table": "order_items",
      "rule": "null_unverifiable_line_total",
      "issue": "line total cannot be checked with invalid components",
      "affected_records": 2699,
      "action": "set line_total to null",
      "justification": "do not keep an amount that cannot be reconciled to its quantity, price and discount",
      "before_count": 3000600,
      "after_count": 3000000
    },
    {
      "table": "order_items",
      "rule": "recompute_line_total",
      "issue": "incorrect line total",
      "affected_records": 1498,
      "action": "recompute from valid quantity, unit price and item discount",
